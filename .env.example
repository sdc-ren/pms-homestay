# ============================================================================
# ROOT .env — CHỈ cho API (apps/api) + script root (scripts/, infra/scripts/).
# API load theo thứ tự: <cwd>/.env → <root>/.env (apps/api/src/core/config/env.schema.ts),
# rồi validate zod fail-fast: thiếu/sai → dừng boot, in tên biến lỗi.
#
# ⚠️ Các app Next (web-admin :3000, web-staff :3002, web-platform :3003, web-site :3004)
# KHÔNG đọc file này. Mỗi app đọc apps/<app>/.env.local — copy từ .env.example cùng
# thư mục (xem cuối file). landing_page (Vercel) cũng có .env.example riêng.
#
# Nguồn sự thật cho tên/kiểu/mặc định: apps/api/src/core/config/env.schema.ts.
# Giá trị dưới đây khớp infra/docker/docker-compose.dev.yml (pnpm db:up).
# ============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development
API_PORT=3001
# fatal | error | warn | info | debug | trace  (mặc định code: info)
LOG_LEVEL=debug
# Ngưỡng (ms) log unit-of-work `withTenant` chậm kèm tenant_id để soi noisy-neighbor
# (docs/18 D2). 0 = tắt. Bật ở staging/prod khi điều tra cost theo tenant (vd 1000)
# → tìm log `evt:slow_tenant_tx`.
DB_SLOW_TX_LOG_MS=0
# OpenTelemetry auto-instrument (apps/api/src/core/otel/otel.ts). Mặc định BẬT;
# CHỈ giá trị chuỗi 'false' mới tắt (test/setup.ts tự set false). Không vào zod schema.
# OTEL_ENABLED=false

# ── Database (docs/11 §secrets, ADR-0002) ──────────────────────────────────
# Runtime API: app_user (non-superuser, tạo bởi infra/docker/initdb/01-app-user.sql)
# → RLS có hiệu lực thật. Mật khẩu 'app_password' khớp file initdb đó.
# Pool (docs/18 D2): connection_limit = pool MỖI instance API; tổng (số instance ×
# limit) PHẢI < Postgres max_connections. pool_timeout (giây) = chờ slot trước khi lỗi.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/pms?connection_limit=10&pool_timeout=10
# PROD sau PgBouncer (transaction mode — RLS an toàn vì GUC LOCAL, ADR-0002 §4): trỏ
# DATABASE_URL vào PgBouncer + thêm "&pgbouncer=true" và để connection_limit nhỏ (vd 1).
# Migrations/seed/prisma db pull: user postgres (owner) — khớp POSTGRES_USER/PASSWORD
# trong docker-compose.dev.yml. API runtime KHÔNG dùng biến này.
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/pms

# ── Redis (BullMQ + cache + SSE pub/sub) ───────────────────────────────────
# Dev dùng db 0. Test suite (apps/api/test/setup.ts) TỰ ép sang db 1 để cách ly.
REDIS_URL=redis://localhost:6379/0
# Cron/worker BullMQ in-process (HOLD expiry, night-audit…). true ở dev/prod.
# Test ép cứng false. ⚠️ Chạy e2e API local trong khi `pnpm dev` đang bật scheduler
# → test đỏ hàng loạt vì tranh CSDL (không phải lỗi code): tắt API dev trước.
ENABLE_SCHEDULERS=true

# ── Auth (docs/04) ──────────────────────────────────────────────────────────
# Bắt buộc, ≥32 ký tự mỗi secret. Prod: sinh bằng `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters!!
JWT_REFRESH_SECRET=dev-only-change-me-too-min-32-chars!!!
# Platform-auth (B4): ký JWT admin nền tảng (bảng platform_users, web-platform :3003).
# TÁCH biệt JWT_ACCESS_SECRET. Thiếu → /platform/auth/login + confirm thuê bao trả 503.
JWT_PLATFORM_SECRET=dev-only-platform-jwt-secret-min-32-chars!
# Bắt buộc 2FA cho OWNER/ACCOUNTANT (task 8.4). Mặc định false. Chỉ bật ở prod SAU
# khi các tài khoản đặc quyền đã enroll (nếu không họ bị 403 AUTH_2FA_REQUIRED_FOR_ROLE).
ENFORCE_2FA_FOR_PRIVILEGED_ROLES=false
# Domain cookie refresh. Prod: .pmsapp.vn. Dev để trống (host-only cookie).
# COOKIE_DOMAIN=.pmsapp.vn
# Base URL web-admin — dựng link reset password trong email. Khớp port web-admin.
APP_WEB_URL=http://localhost:3000

# ── PII field encryption (ADR-0007) ────────────────────────────────────────
# PII_ENC_KEY_CURRENT = "<key_id>:<base64 32 bytes>" (đổi key_id khi rotate).
# PII_HMAC_KEY ≥32 ký tự. Prod: `openssl rand -base64 32` cho mỗi cái.
PII_ENC_KEY_CURRENT=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PII_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Object storage S3-compatible (ADR-0004; prod: R2/S3) ───────────────────
# 4 biến bắt buộc (zod) nhưng compose dev KHÔNG có MinIO. Vẫn chạy được vì presign
# ký cục bộ, không gọi mạng. Chỉ getObject/deleteObject (OCR CCCD, xoá ảnh) mới cần
# store thật; deleteObject là best-effort. Muốn upload thật ở local: chạy MinIO
# `docker run -p 9000:9000 minio/minio server /data` và tạo bucket pms-local.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pms-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Thanh toán (task 3.4) ──────────────────────────────────────────────────
# HMAC secret xác thực webhook Casso/SePay, ≥16 ký tự. THIẾU → API từ chối mọi webhook
# thanh toán (dev không cần trừ khi test đối soát; e2e tự set).
# PAYMENT_WEBHOOK_SECRET=

# ── Observability (docs/11 §3) ─────────────────────────────────────────────
# Sentry: để trống → no-op (dev/test). Bật ở staging/prod bằng DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging      # nhãn env trên Sentry; trống → lấy NODE_ENV
# SENTRY_RELEASE=                 # vd git SHA — gắn version vào event
# Upload source map lúc build (đặt ở CI secrets — KHÔNG commit token):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Backup → R2 (task 8.1, docs/11 §6 + docs/17 §1) ─────────────────────────
# Chỉ cho infra/scripts/backup-db.sh (host cron) + restore-drill.sh; KHÔNG vào zod.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pms-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# R2_BUCKET_DR=                     # bucket khác vùng cho copy weekly (tuỳ chọn)
# R2_ENDPOINT_DR=                   # endpoint của bucket DR (tuỳ chọn)
# BACKUP_KEY=                       # khoá mã hoá dump (nếu script bật)
# BACKUP_DATABASE_URL=              # mặc định = DATABASE_URL_MIGRATIONS
# DRILL_DATABASE_URL=               # DB NHÁP cho restore-drill (KHÔNG phải prod)

# ── Mail (dev: Mailpit trong compose — SMTP 1025, UI http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Kênh gửi ngoài SMS/ZNS (Đợt 4 — mock/sandbox, KHÔNG cần creds thật) ─────
# mock = MockMessagingProvider (SENT + id mock-<uuid>) — mặc định dev/CI.
# log  = LogMessagingProvider (chỉ log, không I/O ngoài).
# esms / zalo = slot creds Phase sau (CHƯA impl — registry ném 'provider chưa cấu hình').
# EMAIL luôn qua SMTP ở trên.
SMS_PROVIDER=mock
ZNS_PROVIDER=mock

# ── OCR CCCD/hộ chiếu (Đợt 4/M3) ────────────────────────────────────────────
# auto = FptOcrProvider (có FPT_AI_API_KEY → gọi FPT.AI; không có → 503, nhập tay).
# fpt  = luôn FptOcrProvider. mock = MockOcrProvider (tất định từ SHA-256 image_key,
# không I/O ngoài) — mock KHÔNG bao giờ tự bật, chỉ khi set tường minh.
OCR_PROVIDER=auto
# FPT_AI_API_KEY=
# FPT_AI_ENDPOINT=https://api.fpt.ai/vision/idr/vnm

# ── Billing SaaS (task 4.7 + Đợt 4/M2) ──────────────────────────────────────
# Tài khoản nhận phí nền tảng cho VietQR động (mặc định dev: MB BIN 970422).
PLATFORM_BANK_BIN=970422
PLATFORM_BANK_ACCOUNT=0000000000
# manual = PENDING + QR, platform admin xác nhận tay. mock = sandbox tự confirm
# (delayed job + POST /public/billing/mock-gateway/:ref/pay).
BILLING_GATEWAY=manual
# Số giây trễ trước khi mock-gateway tự confirm (chỉ áp khi BILLING_GATEWAY=mock).
MOCK_GATEWAY_AUTOCONFIRM_SECONDS=15
# @deprecated B4 — đã thay bằng JWT_PLATFORM_SECRET; giữ để không vỡ env cũ.
# PLATFORM_ADMIN_SECRET=dev-only-platform-secret-min-16

# ── Demo tools (Đợt 4/M4 — dev-only) ────────────────────────────────────────
# HARD-GATE endpoint POST /api/v1/dev/simulate-bank-transfer (giả lập chuyển khoản
# để khép vòng demo hosted booking). false = endpoint VÔ HÌNH (404) — an toàn PROD.
# CHỈ nhận 'true' | 'false'; giá trị khác (yes/1) → app từ chối boot.
DEMO_TOOLS_ENABLED=false

# ============================================================================
# FRONTEND — KHÔNG cấu hình ở đây. Chạy 1 lần sau khi clone:
#   cp apps/web-admin/.env.example    apps/web-admin/.env.local
#   cp apps/web-staff/.env.example    apps/web-staff/.env.local
#   cp apps/web-platform/.env.example apps/web-platform/.env.local
#   cp apps/web-site/.env.example     apps/web-site/.env.local
# rồi RESTART `pnpm dev` (Next nội suy NEXT_PUBLIC_* lúc khởi động). Thiếu file
# web-admin/.env.local → login báo TENANT_CONTEXT_MISSING.
# ============================================================================
